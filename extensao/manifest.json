{
  "manifest_version": 3,
  "name": "Conclusões Projudi",
  "version": "1.0.71",
  "description": "Confere automaticamente as conclusões não analisadas e pré-analisadas de cada serventia no Projudi/TJGO.",
  "permissions": [
    "activeTab",
    "downloads",
    "notifications",
    "offscreen",
    "power",
    "scripting",
    "storage",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.tjgo.jus.br/*",
    "https://judicial-mysql.assessor.net.br/*",
    "https://docs.google.com/document/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icone.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conclusões Projudi"
  },
  "commands": {
    "capturar-tela": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capturar a tela atual (HTML) para diagnóstico"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tjgo.jus.br/*"
      ],
      "js": [
        "editor-ponte.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.tjgo.jus.br/*"
      ],
      "js": [
        "sugestoes.js",
        "agaia-botao.js",
        "arquivos-core.js",
        "baixador.js",
        "gerarpdf.js",
        "modelos-projudi.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://judicial-mysql.assessor.net.br/*"
      ],
      "js": [
        "prompt-similar.js",
        "studio-base.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://judicial-mysql.assessor.net.br/*"
      ],
      "js": [
        "studio-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.tjgo.jus.br/*",
        "https://docs.google.com/document/*"
      ],
      "js": [
        "esteira-barra.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://simplesefacil.tjgo.jus.br/agaia/*"
      ],
      "js": [
        "prompt-similar.js",
        "agaia-rota.js",
        "agaia-form.js",
        "agaia-exec.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
