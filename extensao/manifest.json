{
  "manifest_version": 3,
  "name": "Conclusões Projudi",
  "version": "1.0.0",
  "description": "Confere automaticamente as conclusões não analisadas e pré-analisadas de cada serventia no Projudi/TJGO.",
  "permissions": [
    "activeTab",
    "alarms",
    "downloads",
    "notifications",
    "offscreen",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.tjgo.jus.br/*",
    "https://*.ai.studio/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icone.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conclusões Projudi"
  },
  "commands": {
    "capturar-tela": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Capturar a tela atual (HTML) para diagnóstico"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tjgo.jus.br/*"
      ],
      "js": [
        "editor-ponte.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.tjgo.jus.br/*"
      ],
      "js": [
        "formatacao-core.js",
        "formatador.js",
        "arquivos-core.js",
        "baixador.js",
        "gerarpdf.js",
        "copiar-tela.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ai.studio/*"
      ],
      "js": [
        "studio-diag.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ai.studio/*"
      ],
      "js": [
        "studio-base.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.ai.studio/*"
      ],
      "js": [
        "studio-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}